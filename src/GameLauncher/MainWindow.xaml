<Window x:Class="GameLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StarRailAutoBattle"
        Width="720" Height="880" MinWidth="560" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        TextOptions.TextFormattingMode="Display">
    <Grid Margin="28,24,28,16" MaxWidth="760">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="STAR RAIL AUTO BATTLE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
            <TextBlock Text="StarRailAutoBattle" FontSize="24" FontWeight="SemiBold" Margin="0,2,0,4" />
            <TextBlock Text="“视频”页录制并识别 B 站视频里的行动轴；“目标流程”页编辑凹分检定用的目标流程；“游戏”页启动或识别游戏；“设置”页调整键位和战斗参数。点击各页的“启动”之前，不会打开或启动任何东西。"
                       Foreground="{StaticResource MutedBrush}" FontSize="13" />
        </StackPanel>

        <TabControl Grid.Row="1" x:Name="Pages">

            <!-- ==================== Video ==================== -->
            <TabItem Header="视频" AutomationProperties.Name="视频页">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,14,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource LabelText}" Text="B 站视频链接" />
                                <TextBox x:Name="VideoLinkBox" TextChanged="VideoLinkBox_TextChanged" AutomationProperties.Name="B 站视频链接" />
                                <TextBlock x:Name="VideoLinkError" Style="{StaticResource ErrorText}" Visibility="Collapsed" />
                                <TextBlock Style="{StaticResource HelpText}"
                                           Text="可直接粘贴 B 站的分享文字或链接（www.bilibili.com/video/BV… 或 b23.tv 短链接）。点击“启动”后，程序在后台播放（不显示窗口、不抢前台），自动关闭弹幕、选择可用的最高清晰度，按每秒 15 帧录下所选时间段后再识别。截图跟不上时会放慢播放，因此录制用时可能比片段本身长。" />
                                <Border Margin="0,12,0,0" Padding="12,10" Background="{StaticResource InfoBackBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="BiliAccountText" Text="B 站登录：正在检查…" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" x:Name="BiliLoginButton" Content="登录 B 站…" Margin="8,0,0,0"
                                                    Style="{StaticResource SecondaryButton}" Click="BiliLoginButton_Click" />
                                            <Button Grid.Column="2" x:Name="BiliLogoutButton" Content="退出登录" Margin="8,0,0,0"
                                                    Style="{StaticResource SecondaryButton}" Click="BiliLogoutButton_Click" Visibility="Collapsed" />
                                        </Grid>
                                        <TextBlock Style="{StaticResource HelpText}"
                                                   Text="B 站不登录时只能播放 360P，登录后可录 1080P（1080P 60 帧需要大会员）。登录只需一次，在本程序自己的浏览器里进行，账号和密码由 B 站页面处理，本程序不读取、不保存；不会使用 Edge 浏览器里已有的登录。" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource LabelText}" Text="时间段（可选）" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="起点" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13" />
                                    <TextBox Grid.Column="1" x:Name="VideoStartBox" TextChanged="VideoTimeBox_TextChanged" AutomationProperties.Name="起点" />
                                    <TextBlock Grid.Column="2" Text="终点" VerticalAlignment="Center" Margin="16,0,8,0" FontSize="13" />
                                    <TextBox Grid.Column="3" x:Name="VideoEndBox" TextChanged="VideoTimeBox_TextChanged" AutomationProperties.Name="终点" />
                                </Grid>
                                <TextBlock x:Name="VideoTimeError" Style="{StaticResource ErrorText}" Visibility="Collapsed" />
                                <TextBlock Style="{StaticResource HelpText}"
                                           Text="写成 1:14 或 74（秒）。都不填则处理整段视频；只填起点则处理到视频结尾；只填终点则从开头开始。对链接和自录文件都有效。" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource LabelText}" Text="自录视频文件（可选）" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="VideoFileBox" TextChanged="VideoFileBox_TextChanged" AutomationProperties.Name="自录视频文件路径" />
                                    <Button Grid.Column="1" x:Name="BrowseVideoFileButton" Content="浏览文件…" Margin="8,0,0,0"
                                            Style="{StaticResource SecondaryButton}" Click="BrowseVideoFileButton_Click" />
                                    <Button Grid.Column="2" x:Name="ClearVideoFileButton" Content="清除" Margin="8,0,0,0"
                                            Style="{StaticResource SecondaryButton}" Click="ClearVideoFileButton_Click" />
                                </Grid>
                                <TextBlock x:Name="VideoFileError" Style="{StaticResource ErrorText}" Visibility="Collapsed" />
                                <TextBlock Style="{StaticResource HelpText}"
                                           Text="链接无法录制时（例如要求登录、出现人机验证、画面黑屏或找不到播放器），可以选择你自己录好的视频文件。选择了文件时直接识别文件，不再打开链接。支持 mp4、mkv、mov、avi、webm、flv。" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource LabelText}" Text="队伍（生成目标流程用，可选）" />
                                <TextBox x:Name="SequenceTeamBox" AutomationProperties.Name="队伍，从左到右" />
                                <TextBlock Style="{StaticResource HelpText}"
                                           Text="按队伍栏从左到右写四个角色，用逗号或空格隔开，例如：昔涟，长夜月，风堇，记忆主（攻略视频的简介里一般有）。填了以后，队伍栏终结技按钮熄灭时能认出是谁放的终结技；不填时只标“队伍第几位”。" />
                            </StackPanel>
                        </Border>

                        <WrapPanel Margin="0,4,0,14">
                            <Button x:Name="VideoStartButton" Content="启动" Style="{StaticResource PrimaryButton}" Click="VideoStartButton_Click" Margin="0,0,10,0" />
                            <Button x:Name="VideoCancelButton" Content="取消" Style="{StaticResource SecondaryButton}"
                                    Click="VideoCancelButton_Click" Visibility="Collapsed" Margin="0,0,10,0" />
                            <Button x:Name="EditResultButton" Content="编辑结果" Style="{StaticResource SecondaryButton}"
                                    Click="EditResultButton_Click" IsEnabled="False" Margin="0,0,10,0"
                                    ToolTip="用记事本等文本编辑器打开识别结果的可编辑副本（result_edit.txt）。工具生成的原始结果保持只读，不会被改动。" />
                            <Button x:Name="MakeSequenceButton" Content="生成目标流程" Style="{StaticResource SecondaryButton}"
                                    Click="MakeSequenceButton_Click" IsEnabled="False" Margin="0,0,10,0"
                                    ToolTip="按画面事件（回合开始、终结技、换波、转阶段、读数）把这段视频整理成目标流程，填进“目标流程”页，核对后再保存。比识别结果慢，3 分钟视频约需 5 分钟。" />
                            <Button x:Name="OpenRunFolderButton" Content="打开结果文件夹" Style="{StaticResource SecondaryButton}"
                                    Click="OpenRunFolderButton_Click" Visibility="Collapsed" />
                        </WrapPanel>

                        <Border x:Name="VideoStatusBorder" Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="VideoStatusDot" Width="10" Height="10" Fill="#9AA5B5" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock x:Name="VideoStatusTitle" Text="准备就绪" FontWeight="SemiBold" FontSize="14" />
                                </StackPanel>
                                <ProgressBar x:Name="VideoProgress" Margin="18,10,0,0" Minimum="0" Maximum="100" Visibility="Collapsed" />
                                <TextBlock x:Name="VideoStatusText" FontSize="13" Margin="18,8,0,0"
                                           Text="点击“启动”后，这里会显示录制和识别的进度。识别结果保存为文本文件，可用“编辑结果”打开。" />
                                <TextBlock x:Name="VideoStatusNote" FontSize="12" Margin="18,6,0,0" Foreground="#8A5A00" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== Expected sequence ==================== -->
            <TabItem x:Name="SequenceTab" Header="目标流程" AutomationProperties.Name="目标流程页">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,14,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource LabelText}" Text="流程" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="打开" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13" />
                                    <ComboBox Grid.Column="1" x:Name="SequencePicker" FontSize="13" Padding="8,6" VerticalContentAlignment="Center"
                                              SelectionChanged="SequencePicker_SelectionChanged" AutomationProperties.Name="已保存的流程" />
                                    <TextBlock Grid.Column="2" Text="名称" VerticalAlignment="Center" Margin="16,0,8,0" FontSize="13" />
                                    <TextBox Grid.Column="3" x:Name="SequenceNameBox" TextChanged="SequenceNameBox_TextChanged" AutomationProperties.Name="流程名称" />
                                </Grid>
                                <TextBlock x:Name="SequenceNameError" Style="{StaticResource ErrorText}" Visibility="Collapsed" />
                                <TextBlock Style="{StaticResource HelpText}"
                                           Text="一份流程对应一整场战斗（从战斗开始到结算）。选择“（新流程）”从空白开始；改了名称再保存，就另存为新流程。" />
                                <!-- R74: team slots, saved as the first line of the flow file -->
                                <TextBlock Text="队伍站位" FontSize="13" FontWeight="SemiBold" Margin="0,14,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="1号" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="13" />
                                    <TextBox Grid.Column="1" x:Name="SequenceTeamSlot1" TextChanged="SequenceTeamSlot_TextChanged" AutomationProperties.Name="1号位" />
                                    <TextBlock Grid.Column="2" Text="2号" VerticalAlignment="Center" Margin="12,0,6,0" FontSize="13" />
                                    <TextBox Grid.Column="3" x:Name="SequenceTeamSlot2" TextChanged="SequenceTeamSlot_TextChanged" AutomationProperties.Name="2号位" />
                                    <TextBlock Grid.Column="4" Text="3号" VerticalAlignment="Center" Margin="12,0,6,0" FontSize="13" />
                                    <TextBox Grid.Column="5" x:Name="SequenceTeamSlot3" TextChanged="SequenceTeamSlot_TextChanged" AutomationProperties.Name="3号位" />
                                    <TextBlock Grid.Column="6" Text="4号" VerticalAlignment="Center" Margin="12,0,6,0" FontSize="13" />
                                    <TextBox Grid.Column="7" x:Name="SequenceTeamSlot4" TextChanged="SequenceTeamSlot_TextChanged" AutomationProperties.Name="4号位" />
                                </Grid>
                                <TextBlock Style="{StaticResource HelpText}"
                                           Text="队伍栏从左到右的四个角色，填名称或 U 编号，可以只填几个；随流程一起保存。自动操作按这里的号位放终结技，终结技行的单位不在这里时会有提醒。" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Style="{StaticResource LabelText}" Text="目标流程和检定条件" Margin="0" />
                                    <TextBlock x:Name="SequenceCaretText" HorizontalAlignment="Right" FontSize="12"
                                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Bottom" />
                                </Grid>
                                <TextBox x:Name="SequenceEditor" Height="340" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                                         VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                         FontFamily="Consolas, Microsoft YaHei UI" FontSize="14"
                                         TextChanged="SequenceEditor_TextChanged" SelectionChanged="SequenceEditor_SelectionChanged"
                                         PreviewTextInput="SequenceEditor_PreviewTextInput" PreviewKeyDown="SequenceEditor_PreviewKeyDown"
                                         AutomationProperties.Name="目标流程文本" />
                                <!-- R60: shown while the caret is on an extra ultimate line -->
                                <Border x:Name="SequenceTimingBar" Visibility="Collapsed" Margin="0,8,0,0" Padding="12,8" Background="{StaticResource InfoBackBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="SequenceTimingTitle" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                            <TextBlock Text="定时" FontSize="13" VerticalAlignment="Center" Margin="14,0,6,0" />
                                            <TextBox x:Name="SequenceTimingBox" Width="110" FontSize="13" Padding="6,3" VerticalContentAlignment="Center"
                                                     TextChanged="SequenceTimingBox_TextChanged" PreviewTextInput="SequenceTimingBox_PreviewTextInput"
                                                     PreviewKeyDown="SequenceTimingBox_PreviewKeyDown" InputMethod.IsInputMethodEnabled="False"
                                                     AutomationProperties.Name="定时（毫秒）"
                                                     ToolTip="填 0 或正整数；留空就不定时。" />
                                            <TextBlock Text="毫秒" FontSize="13" VerticalAlignment="Center" Margin="6,0,0,0" />
                                        </StackPanel>
                                        <TextBlock x:Name="SequenceTimingText" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="SequenceCheckBorder" Margin="0,10,0,0" Padding="12,10" Background="{StaticResource InfoBackBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="SequenceCheckDot" Width="10" Height="10" Fill="#9AA5B5" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock x:Name="SequenceCheckTitle" Text="还没有内容" FontWeight="SemiBold" FontSize="13" />
                                        </StackPanel>
                                        <TextBlock x:Name="SequenceCheckText" FontSize="12" Margin="18,4,0,0" Foreground="{StaticResource MutedBrush}" />
                                        <ListBox x:Name="SequenceIssueList" Margin="18,8,0,0" MaxHeight="160" BorderThickness="0" Background="Transparent"
                                                 FontSize="12" Visibility="Collapsed" SelectionChanged="SequenceIssueList_SelectionChanged"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="格式问题列表" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Style="{StaticResource HelpText}"
                                           Text="边输入边检查格式；点问题列表里的一行，光标会跳到对应的行。单位名称按识别知识库检查。" />
                                <Expander Header="写法说明" Margin="0,10,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}">
                                    <TextBox IsReadOnly="True" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12" VerticalContentAlignment="Top"
                                             FontFamily="Consolas, Microsoft YaHei UI" Background="{StaticResource InfoBackBrush}"
                                             Text="一行一步：序号 单位 [招式] [目标] [定时] [@ 条件]，各项之间用空格隔开。方括号里的可以不填：招式不填只记顺序，目标不填时默认打 boss（没有 boss 时用游戏默认目标）。# 后面是注释。&#x0a;&#x0a;1 长夜月&#x0a;2 昔涟 战技 敌2      @ 轮次=1 行动值=120~160&#x0a;2-1 长夜月 终结技 定时=1250&#x0a;2-2 风堇 终结技 我3 定时=300&#x0a;== 换波 ==&#x0a;1 昔涟 敌(0)&#x0a;== 转阶段 ==  @ 行动值=50~100&#x0a;1 U0003 敌(+1)&#x0a;&#x0a;· 序号：n 是本段第 n 次主轴行动；n-1、n-2… 是挂在主轴行动 n 下的额外行动（终结技），连续的终结技都算同一次主轴行动的额外行动；本段第一次主轴行动前的额外行动写 0-1。&#x0a;· 换段：== 换波 == 或 == 转阶段 ==（混沌回忆上下半也算换波），之后序号从 1 重新开始。&#x0a;· 单位：名称或 U 编号。只写我方单位，敌方行动不写。&#x0a;· 招式（可选）：普攻、战技、终结技。目标（可选，不写箭头）：敌2 从左数；敌(0) 是 boss，敌(-1)、敌(+1) 是它左右一个；我1 是我方从左数。招式和目标只作记录，不参与判定。&#x0a;· 定时（可选，只用于额外行动的终结技行）：定时=1250 表示前一行的行动开始后 1250 毫秒释放这个终结技；前一行是主轴行动时从它的回合开始算，是终结技时从它释放的那一刻算。上例中 2-1 在 2 号行动开始 1.25 秒后释放，2-2 在 2-1 释放 0.3 秒后释放。光标停在终结技行时，编辑框下方会出现定时输入框。定时只给自动操作用，不参与判定。&#x0a;· 条件（可选）：@ 轮次=1 行动值=120~160，只在写了条件的步骤读取轮次和剩余行动值；其余步骤只比对顺序。&#x0a;· 全角括号、等号、波浪号和全角数字都可以。" />
                                </Expander>
                            </StackPanel>
                        </Border>

                        <WrapPanel Margin="0,4,0,14">
                            <Button x:Name="SequenceSaveButton" Content="保存" Style="{StaticResource PrimaryButton}" Click="SequenceSaveButton_Click" Margin="0,0,10,0" />
                            <Button x:Name="SequenceReloadButton" Content="放弃修改" Style="{StaticResource SecondaryButton}"
                                    Click="SequenceReloadButton_Click" IsEnabled="False" Margin="0,0,10,0"
                                    ToolTip="丢掉还没保存的修改，回到上次保存的内容。" />
                            <Button x:Name="SequenceFolderButton" Content="打开流程文件夹" Style="{StaticResource SecondaryButton}"
                                    Click="SequenceFolderButton_Click"
                                    ToolTip="流程保存为文本文件，供后续自动操作的程序读取。一般不需要打开。" />
                        </WrapPanel>
                        <TextBlock x:Name="SequenceSaveText" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="2,0,0,14" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== Game ==================== -->
            <TabItem Header="游戏" AutomationProperties.Name="游戏页">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,14,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource LabelText}" Text="游戏入口（.exe 或 .lnk 快捷方式）" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="EntryBox" TextChanged="EntryBox_TextChanged"
                                             AutomationProperties.Name="游戏入口路径" />
                                    <Button Grid.Column="1" x:Name="BrowseEntryButton" Content="浏览文件…" Margin="8,0,0,0"
                                            Style="{StaticResource SecondaryButton}" Click="BrowseEntryButton_Click" />
                                </Grid>
                                <TextBlock x:Name="EntryError" Style="{StaticResource ErrorText}" Visibility="Collapsed" />
                                <Border x:Name="EntryInfoPanel" Visibility="Collapsed" Margin="0,10,0,0" Padding="12,10"
                                        Background="{StaticResource InfoBackBrush}" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="6">
                                    <StackPanel>
                                        <TextBlock x:Name="EntryTypeText" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock x:Name="EntryDetailsText" FontSize="12" Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" />
                                        <TextBlock x:Name="EntryWarningText" FontSize="12" Margin="0,6,0,0" Foreground="#8A5A00" Visibility="Collapsed" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Style="{StaticResource HelpText}"
                                           Text="可选择游戏或官方启动器的真实 .exe，也可选择它们的快捷方式。快捷方式的目标、参数和“起始位置”按快捷方式本身的设置由 Windows 处理。资源管理器可能隐藏 .lnk 扩展名，请以上方显示的“实际类型”为准。" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource LabelText}" Text="运行模式" Margin="0,0,0,10" />
                                <RadioButton x:Name="ModeStart" GroupName="Mode" IsChecked="True">
                                    <StackPanel Margin="6,-2,0,0">
                                        <TextBlock Text="启动游戏" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Style="{StaticResource HelpText}" Margin="0,2,0,0"
                                                   Text="像在资源管理器中双击一样打开所选入口。若程序要求管理员权限，Windows 会弹出确认框，由你决定。之后会等待游戏窗口出现并尝试切到前台。" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="ModeIdentify" GroupName="Mode" Margin="0">
                                    <StackPanel Margin="6,-2,0,0">
                                        <TextBlock Text="只识别已运行游戏" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Style="{StaticResource HelpText}" Margin="0,2,0,0"
                                                   Text="不启动任何程序。查找你已通过官方启动器打开的游戏窗口，尝试还原并切到前台。适合游戏必须由官方启动器启动的情况。" />
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource LabelText}" Text="识别窗口用的游戏程序（可选）" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="GameExeBox" TextChanged="GameExeBox_TextChanged"
                                             AutomationProperties.Name="识别窗口用的游戏程序路径" />
                                    <Button Grid.Column="1" x:Name="BrowseGameButton" Content="浏览文件…" Margin="8,0,0,0"
                                            Style="{StaticResource SecondaryButton}" Click="BrowseGameButton_Click" />
                                </Grid>
                                <TextBlock x:Name="GameExeError" Style="{StaticResource ErrorText}" Visibility="Collapsed" />
                                <TextBlock Style="{StaticResource HelpText}"
                                           Text="如果上方入口是官方启动器，请在这里选择游戏本体的 .exe（例如游戏安装目录里的主程序），用来识别游戏窗口。留空时使用入口实际指向的程序。" />
                            </StackPanel>
                        </Border>

                        <WrapPanel Margin="0,4,0,14">
                            <Button x:Name="LaunchButton" Content="启动" Style="{StaticResource PrimaryButton}" Click="LaunchButton_Click" Margin="0,0,10,0" />
                            <Button x:Name="ActivateButton" Content="切换到游戏窗口" Style="{StaticResource SecondaryButton}"
                                    Click="ActivateButton_Click" Visibility="Collapsed" Margin="0,0,10,0" />
                            <Button x:Name="CancelWaitButton" Content="停止等待窗口" Style="{StaticResource SecondaryButton}"
                                    Click="CancelWaitButton_Click" Visibility="Collapsed" />
                        </WrapPanel>

                        <Border x:Name="StatusBorder" Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#9AA5B5" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock x:Name="StatusTitle" Text="准备就绪" FontWeight="SemiBold" FontSize="14" />
                                </StackPanel>
                                <TextBlock x:Name="StatusGame" FontSize="13" Margin="18,8,0,0"
                                           Text="点击“启动”后，这里会显示游戏的处理结果。" />
                                <Expander x:Name="DiagnosticsExpander" Header="诊断详情（只含文件名和错误码，不含完整路径）" Margin="0,12,0,0"
                                          FontSize="12" Foreground="{StaticResource MutedBrush}" Visibility="Collapsed">
                                    <StackPanel Margin="0,6,0,0">
                                        <TextBox x:Name="DiagnosticsBox" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas, Microsoft YaHei UI"
                                                 FontSize="12" MaxHeight="220" VerticalScrollBarVisibility="Auto" />
                                        <Button Content="打开日志文件夹" HorizontalAlignment="Left" Margin="0,8,0,0"
                                                Style="{StaticResource SecondaryButton}" Click="OpenLogFolder_Click" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== Settings (R75) ==================== -->
            <TabItem x:Name="SettingsTab" Header="设置" AutomationProperties.Name="设置页">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,14,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource LabelText}" Text="键位" />
                                <Grid x:Name="SettingsKeyGrid">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="普攻" Style="{StaticResource SettingsLabel}" />
                                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="SettingsKeyBasic" Style="{StaticResource SettingsKeyBox}" AutomationProperties.Name="普攻键" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="战技" Style="{StaticResource SettingsLabel}" Margin="16,0,8,0" />
                                    <TextBox Grid.Row="0" Grid.Column="3" x:Name="SettingsKeySkill" Style="{StaticResource SettingsKeyBox}" AutomationProperties.Name="战技键" />
                                    <TextBlock Grid.Row="1" x:Name="SettingsKeyUlt1Label" Text="终结技 1号" Style="{StaticResource SettingsLabel}" />
                                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="SettingsKeyUlt1" Style="{StaticResource SettingsKeyBox}" AutomationProperties.Name="终结技1号位键" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" x:Name="SettingsKeyUlt2Label" Text="终结技 2号" Style="{StaticResource SettingsLabel}" Margin="16,0,8,0" />
                                    <TextBox Grid.Row="1" Grid.Column="3" x:Name="SettingsKeyUlt2" Style="{StaticResource SettingsKeyBox}" AutomationProperties.Name="终结技2号位键" />
                                    <TextBlock Grid.Row="2" x:Name="SettingsKeyUlt3Label" Text="终结技 3号" Style="{StaticResource SettingsLabel}" />
                                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="SettingsKeyUlt3" Style="{StaticResource SettingsKeyBox}" AutomationProperties.Name="终结技3号位键" />
                                    <TextBlock Grid.Row="2" Grid.Column="2" x:Name="SettingsKeyUlt4Label" Text="终结技 4号" Style="{StaticResource SettingsLabel}" Margin="16,0,8,0" />
                                    <TextBox Grid.Row="2" Grid.Column="3" x:Name="SettingsKeyUlt4" Style="{StaticResource SettingsKeyBox}" AutomationProperties.Name="终结技4号位键" />
                                    <TextBlock Grid.Row="3" Text="确认释放" Style="{StaticResource SettingsLabel}" />
                                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="SettingsKeyConfirm" Style="{StaticResource SettingsKeyBox}" AutomationProperties.Name="确认键" />
                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="菜单" Style="{StaticResource SettingsLabel}" Margin="16,0,8,0" />
                                    <TextBox Grid.Row="3" Grid.Column="3" x:Name="SettingsKeyMenu" Style="{StaticResource SettingsKeyBox}" AutomationProperties.Name="菜单键" />
                                    <TextBlock Grid.Row="4" Text="目标左移" Style="{StaticResource SettingsLabel}" />
                                    <TextBox Grid.Row="4" Grid.Column="1" x:Name="SettingsKeyLeft" Style="{StaticResource SettingsKeyBox}" AutomationProperties.Name="目标左移键" />
                                    <TextBlock Grid.Row="4" Grid.Column="2" Text="目标右移" Style="{StaticResource SettingsLabel}" Margin="16,0,8,0" />
                                    <TextBox Grid.Row="4" Grid.Column="3" x:Name="SettingsKeyRight" Style="{StaticResource SettingsKeyBox}" AutomationProperties.Name="目标右移键" />
                                </Grid>
                                <TextBlock Style="{StaticResource HelpText}"
                                           Text="要和游戏里的按键设置一致。可以填字母、数字、F1–F12、Space、Enter、Tab、Esc、Shift、Ctrl、Alt、Left、Right、Up、Down。终结技按队伍栏从左到右的号位（目标流程页的队伍站位）。" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource LabelText}" Text="发键方式" />
                                <CheckBox x:Name="SettingsFakeActivate" Content="假激活（游戏在后台时让它以为自己在前台）" FontSize="13" Margin="0,0,0,4"
                                          Checked="SettingsField_Changed" Unchecked="SettingsField_Changed" AutomationProperties.Name="假激活" />
                                <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,8"
                                           Text="不开时游戏在后台收不到按键（实测）。开着也不会切到前台、不注入游戏进程。" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="按住时长" Style="{StaticResource SettingsLabel}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBox x:Name="SettingsHold" Style="{StaticResource SettingsNumberBox}" AutomationProperties.Name="按住时长（毫秒）" />
                                        <TextBlock Text="毫秒" Style="{StaticResource SettingsUnit}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="普攻、战技按两次" Style="{StaticResource SettingsLabel}" Margin="16,0,8,0" />
                                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                                        <TextBox x:Name="SettingsTwice" Style="{StaticResource SettingsNumberBox}" AutomationProperties.Name="按两次的间隔" />
                                        <TextBlock Text="毫秒间隔" Style="{StaticResource SettingsUnit}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Style="{StaticResource HelpText}"
                                           Text="按住时长：每个键按下后按住多久再抬起（0–1000）。按两次：第一下选中、第二下放出，中间隔多久（0–2000，0 = 只按一次）。" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource LabelText}" Text="战斗参数" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="终结技立绘时长" Style="{StaticResource SettingsLabel}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBox x:Name="SettingsSplash" Style="{StaticResource SettingsNumberBox}" AutomationProperties.Name="终结技立绘时长（毫秒）" />
                                        <TextBlock Text="毫秒" Style="{StaticResource SettingsUnit}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="终结技动画时长" Style="{StaticResource SettingsLabel}" Margin="16,0,8,0" />
                                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                                        <TextBox x:Name="SettingsAnim" Style="{StaticResource SettingsNumberBox}" AutomationProperties.Name="终结技动画时长默认值（毫秒）" />
                                        <TextBlock Text="毫秒（默认）" Style="{StaticResource SettingsUnit}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Style="{StaticResource HelpText}" Margin="0,4,0,8"
                                           Text="立绘时长：按下终结技键后先放立绘，立绘放完才能按下一个终结技键或确认（0–5000）。动画时长：终结技确认释放后，等技能动画放完再按下一个键（0–20000）。" />
                                <TextBlock Text="各号位的动画时长（留空 = 用默认）" FontSize="13" Margin="0,4,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition /><RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="SettingsAnim1Label" Text="1号" Style="{StaticResource SettingsLabel}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBox x:Name="SettingsAnim1" Style="{StaticResource SettingsNumberBox}" AutomationProperties.Name="1号位动画时长" />
                                        <TextBlock Text="毫秒" Style="{StaticResource SettingsUnit}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" x:Name="SettingsAnim2Label" Text="2号" Style="{StaticResource SettingsLabel}" Margin="16,0,8,0" />
                                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                                        <TextBox x:Name="SettingsAnim2" Style="{StaticResource SettingsNumberBox}" AutomationProperties.Name="2号位动画时长" />
                                        <TextBlock Text="毫秒" Style="{StaticResource SettingsUnit}" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" x:Name="SettingsAnim3Label" Text="3号" Style="{StaticResource SettingsLabel}" />
                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                        <TextBox x:Name="SettingsAnim3" Style="{StaticResource SettingsNumberBox}" AutomationProperties.Name="3号位动画时长" />
                                        <TextBlock Text="毫秒" Style="{StaticResource SettingsUnit}" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Grid.Column="2" x:Name="SettingsAnim4Label" Text="4号" Style="{StaticResource SettingsLabel}" Margin="16,0,8,0" />
                                    <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal">
                                        <TextBox x:Name="SettingsAnim4" Style="{StaticResource SettingsNumberBox}" AutomationProperties.Name="4号位动画时长" />
                                        <TextBlock Text="毫秒" Style="{StaticResource SettingsUnit}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Style="{StaticResource HelpText}"
                                           Text="带忆灵技、附带行动的号位动画更长，要单独填长一点（实测风堇带忆灵技要 8000）。号位后面括号里是目标流程页当前的队伍站位。" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource LabelText}" Text="自动重开" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="连续失败" Style="{StaticResource SettingsLabel}" />
                                    <TextBox x:Name="SettingsPauseAfter" Style="{StaticResource SettingsNumberBox}" AutomationProperties.Name="连续失败多少次后暂停" />
                                    <TextBlock Text="次后暂停，并存下最后这一局的录像" Style="{StaticResource SettingsUnit}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource HelpText}" Margin="0,4,0,8"
                                           Text="检定判失败就自动重开；连续失败到这个次数就暂停，录像留给你调整参数。中间成功一次就重新计数。0 = 一直重开、不暂停（0–999）。" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="每局容许" Style="{StaticResource SettingsLabel}" />
                                    <TextBox x:Name="SettingsAllowedPending" Style="{StaticResource SettingsNumberBox}" AutomationProperties.Name="每局容许待定次数" />
                                    <TextBlock Text="次待定，超过就重开" Style="{StaticResource SettingsUnit}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource HelpText}" Margin="0,4,0,8"
                                           Text="待定：画面看不清、拿不准这一步对不对。0 = 第一次待定就重开；大于 0 时，看不清的那一步跳过、继续比对后面的步骤（0–99）。" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="同一步待定累计" Style="{StaticResource SettingsLabel}" />
                                    <TextBox x:Name="SettingsPauseAfterPending" Style="{StaticResource SettingsNumberBox}" AutomationProperties.Name="同一步待定累计多少次后暂停" />
                                    <TextBlock Text="次后暂停，并存下最后这一局的录像" Style="{StaticResource SettingsUnit}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource HelpText}"
                                           Text="按流程里的每一步分别计数：同一步每待定一次加 1，跨局累计；分散在不同步骤的待定各数各的，不会凑在一起暂停。和连续失败分开数；成功一局时所有计数都清零。同一步老是看不清，多半是识别跟不上，录像用来改进识别。0 = 不暂停（0–999）。检定进程还在开发中，这里先保存设置。" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource LabelText}" Text="文件夹" />
                                <Grid x:Name="SettingsFolderGrid">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="数据" Style="{StaticResource SettingsLabel}" />
                                    <TextBlock Grid.Column="1" x:Name="SettingsDataPath" Style="{StaticResource SettingsPath}" />
                                    <Button Grid.Column="2" Content="打开" Tag="data" Style="{StaticResource SecondaryButton}" Click="SettingsOpenFolder_Click" Margin="0,4" />
                                    <TextBlock Grid.Row="1" Text="视频页录像" Style="{StaticResource SettingsLabel}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="SettingsVideoRunsPath" Style="{StaticResource SettingsPath}" />
                                    <Button Grid.Row="1" Grid.Column="2" Content="打开" Tag="video-runs" Style="{StaticResource SecondaryButton}" Click="SettingsOpenFolder_Click" Margin="0,4" />
                                    <TextBlock Grid.Row="2" Text="命令行录像" Style="{StaticResource SettingsLabel}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="SettingsRecordingsPath" Style="{StaticResource SettingsPath}" />
                                    <Button Grid.Row="2" Grid.Column="2" Content="打开" Tag="recordings" Style="{StaticResource SecondaryButton}" Click="SettingsOpenFolder_Click" Margin="0,4" />
                                    <TextBlock Grid.Row="3" Text="日志和设置" Style="{StaticResource SettingsLabel}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="SettingsLogPath" Style="{StaticResource SettingsPath}" />
                                    <Button Grid.Row="3" Grid.Column="2" Content="打开" Tag="logs" Style="{StaticResource SecondaryButton}" Click="SettingsOpenFolder_Click" Margin="0,4" />
                                </Grid>
                                <TextBlock Style="{StaticResource HelpText}"
                                           Text="录像比较大（3 分钟约 1.2 GB），不用的可以在文件夹里自己删除。设置保存在“日志和设置”文件夹里，键位文件 control-keys.json 和 srctl 共用。" />
                            </StackPanel>
                        </Border>

                        <WrapPanel Margin="0,4,0,8">
                            <Button x:Name="SettingsSaveButton" Content="保存设置" Style="{StaticResource PrimaryButton}" Click="SettingsSaveButton_Click" Margin="0,0,10,0" />
                            <Button Content="放弃修改" Style="{StaticResource SecondaryButton}" Click="SettingsReloadButton_Click" Margin="0,0,10,0"
                                    ToolTip="重新读取已保存的设置。" />
                            <Button Content="恢复默认" Style="{StaticResource SecondaryButton}" Click="SettingsDefaultsButton_Click"
                                    ToolTip="把键位、发键方式、战斗参数和自动重开改回默认值（会先确认）。" />
                        </WrapPanel>
                        <TextBlock x:Name="SettingsStatusText" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="2,0,0,14" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="2" HorizontalAlignment="Center" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"
                   Text="识别在本机运行，不调用大模型 · 不上传任何本机路径 · 不会自动以管理员身份运行" />
    </Grid>
</Window>
